SUPABASE_PROJECT_ID=umofughlvohswsfdridk
SUPABASE_PUBLISHABLE_KEY=sb_publishable_NHLcNFfwVFALabxZEhehnA_2PwhGqEf

$arquivo = Join-Path (Get-Location) '.env'
if (-not (Test-Path -LiteralPath $arquivo)) {
  throw 'Não encontrei o arquivo .env nessa pasta.'
}

$novaChave = (Get-Clipboard -Raw).Trim()
if ($novaChave -notmatch '^sb_publishable_') {
  throw 'Copie novamente a Publishable key antes de executar o bloco.'
}

$valores = @{
SUPABASE_URL=https://umofughlvohswsfdridk.supabase.co
VITE_SUPABASE_PROJECT_ID=umofughlvohswsfdridk
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_NHLcNFfwVFALabxZEhehnA_2PwhGqEf
VITE_SUPABASE_URL=https://umofughlvohswsfdridk.supabase.co
}

$linhas = @(Get-Content -LiteralPath $arquivo)
$nomesEncontrados = @(
  foreach ($linha in $linhas) {
    if ($linha -match '^\s*([A-Za-z0-9_]+)\s*=') {
      $Matches[1]
    }
  }
)

$faltando = @($valores.Keys | Where-Object { $_ -notin $nomesEncontrados })
if ($faltando.Count -gt 0) {
  throw "Não alterei o arquivo. Variáveis ausentes no .env: $($faltando -join ', ')"
}

$backup = Join-Path $env:USERPROFILE 'Downloads\Digitalizador-env-antes-da-migracao.bak'
Copy-Item -LiteralPath $arquivo -Destination $backup -Force

for ($i = 0; $i -lt $linhas.Count; $i++) {
  if ($linhas[$i] -match '^\s*([A-Za-z0-9_]+)\s*=') {
    $nome = $Matches[1]
    if ($valores.ContainsKey($nome)) {
      $linhas[$i] = "$nome=$($valores[$nome])"
    }
  }
}

Set-Content -LiteralPath $arquivo -Value $linhas -Encoding utf8

Get-Content -LiteralPath $arquivo |
  Where-Object { $_ -match '^(SUPABASE_PROJECT_ID|VITE_SUPABASE_PROJECT_ID|SUPABASE_URL|VITE_SUPABASE_URL)=' }


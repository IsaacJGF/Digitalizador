{
  "version": 1,
  "sdk_version": "3.4.0",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "digitalizador",
      "version": "0.1.0",
      "title": "Digitalizador"
    },
    "tools": [
      {
        "name": "listar_questoes",
        "title": "Consultar questões",
        "description": "Busca questões públicas por texto e classificação, com paginação; não inclui dados internos de revisão nem imagens grandes.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "busca": {
              "type": "string",
              "maxLength": 200
            },
            "area": {
              "type": "string",
              "maxLength": 200
            },
            "conteudo": {
              "type": "string",
              "maxLength": 200
            },
            "limite": {
              "default": 20,
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "offset": {
              "default": 0,
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "obter_questao",
        "title": "Abrir questão",
        "description": "Lê os textos, alternativas e metadados públicos de uma questão; exclui dados internos de revisão e imagens em base64.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "criar_questao",
        "title": "Cadastrar questão",
        "description": "Cria uma questão pública manual a partir de textos e metadados. Peça confirmação do conteúdo antes de executar.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "questao": {
              "type": "object",
              "properties": {
                "enunciado": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 50000
                },
                "numero": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 100
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "tipo": {
                  "type": "string",
                  "enum": [
                    "multipla_escolha",
                    "discursiva"
                  ]
                },
                "alternativas": {
                  "maxItems": 26,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "letra": {
                        "type": "string",
                        "maxLength": 10
                      },
                      "texto": {
                        "type": "string",
                        "maxLength": 20000
                      }
                    },
                    "required": [
                      "letra",
                      "texto"
                    ],
                    "additionalProperties": false
                  }
                },
                "resposta": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 20000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "referencia_texto": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 50000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "referencia_fonte": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 2000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "area_geral": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 200
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "conteudo_principal": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 200
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "subconteudo_principal": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 200
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "conteudos_relacionados": {
                  "maxItems": 100,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 200
                  }
                },
                "tags_livres": {
                  "maxItems": 100,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 200
                  }
                },
                "ano": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 100
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "prova": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 200
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "instituicao": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 200
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "dificuldade": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 100
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "observacoes": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 20000
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "enunciado"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "questao"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "atualizar_questao",
        "title": "Editar questão",
        "description": "Atualiza somente os campos informados de uma questão pública. Leia a questão antes e peça confirmação; pode reiniciar seus critérios automáticos de revisão.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "updated_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
              "description": "Versão obtida ao ler a questão; impede sobrescrever edições concorrentes."
            },
            "alteracoes": {
              "type": "object",
              "properties": {
                "enunciado": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 50000
                },
                "numero": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 100
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "tipo": {
                  "type": "string",
                  "enum": [
                    "multipla_escolha",
                    "discursiva"
                  ]
                },
                "alternativas": {
                  "maxItems": 26,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "letra": {
                        "type": "string",
                        "maxLength": 10
                      },
                      "texto": {
                        "type": "string",
                        "maxLength": 20000
                      }
                    },
                    "required": [
                      "letra",
                      "texto"
                    ],
                    "additionalProperties": false
                  }
                },
                "resposta": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 20000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "referencia_texto": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 50000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "referencia_fonte": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 2000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "area_geral": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 200
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "conteudo_principal": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 200
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "subconteudo_principal": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 200
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "conteudos_relacionados": {
                  "maxItems": 100,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 200
                  }
                },
                "tags_livres": {
                  "maxItems": 100,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 200
                  }
                },
                "ano": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 100
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "prova": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 200
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "instituicao": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 200
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "dificuldade": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 100
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "observacoes": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 20000
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "id",
            "updated_at",
            "alteracoes"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "listar_catalogo",
        "title": "Consultar catálogo",
        "description": "Lista um dos sete catálogos públicos, incluindo IDs, nome, estado ativo e vínculo pai quando aplicável.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "tipo": {
              "type": "string",
              "enum": [
                "area",
                "conteudo",
                "subconteudo",
                "relacionado",
                "tag",
                "prova",
                "instituicao"
              ]
            },
            "limite": {
              "default": 50,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "offset": {
              "default": 0,
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            }
          },
          "required": [
            "tipo"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "criar_item_catalogo",
        "title": "Cadastrar item de catálogo",
        "description": "Cria um item público; conteúdos exigem parent_id da área e subconteúdos do conteúdo. Peça confirmação antes de executar.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "item": {
              "type": "object",
              "properties": {
                "tipo": {
                  "type": "string",
                  "enum": [
                    "area",
                    "conteudo",
                    "subconteudo",
                    "relacionado",
                    "tag",
                    "prova",
                    "instituicao"
                  ]
                },
                "nome": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "parent_id": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                }
              },
              "required": [
                "tipo",
                "nome"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "item"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "definir_catalogo_ativo",
        "title": "Ativar ou desativar item",
        "description": "Edita o estado ativo de um item público sem renomear, excluir ou alterar questões vinculadas. Peça confirmação antes de executar.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "tipo": {
              "type": "string",
              "enum": [
                "area",
                "conteudo",
                "subconteudo",
                "relacionado",
                "tag",
                "prova",
                "instituicao"
              ]
            },
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "ativo": {
              "type": "boolean"
            }
          },
          "required": [
            "tipo",
            "id",
            "ativo"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}

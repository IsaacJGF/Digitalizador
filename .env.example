# Chave usada pela digitalização com IA.
# Configure este valor no ambiente do projeto antes de usar o botão Digitalizar questão.
LOVABLE_API_KEY=

# Segredo de servidor usado pelas Actions privadas do ChatGPT para cadastrar e revisar questões.
# Configure no ambiente do servidor; não use esse valor em código client-side.
QUESTION_INGEST_TOKEN=
